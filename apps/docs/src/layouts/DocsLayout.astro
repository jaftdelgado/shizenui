---
import "../styles/global.css";
import TableOfContents from "../components/astro/TableOfContents.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  preview?: string;
}

const rawProps = Astro.props;
const frontmatter = (rawProps as any).frontmatter ?? rawProps;

const title = frontmatter.title;
const description = frontmatter.description;
const preview = frontmatter.preview;
const headings: MarkdownHeading[] = rawProps.headings ?? [];

const previewModules = import.meta.glob("../previews/*.astro", {
  eager: true
}) as Record<string, { default?: unknown }>;

const previewPath = preview ? `../previews/${preview}.astro` : undefined;
const PreviewComponent: any = previewPath ? previewModules[previewPath]?.default : undefined;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Docs</title>
    <slot name="head" />
  </head>
  <body>
    <div class="docs-layout">
      <aside class="docs-sidebar">
        <slot name="sidebar" />
      </aside>

      <div class="docs-main">
        <div class="docs-titlebar">
          <div>
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </div>
          <div class="titlebar-actions">
            <slot name="actions" />
          </div>
        </div>

        {
          PreviewComponent && (
            <div class="docs-preview">
              <PreviewComponent />
            </div>
          )
        }

        <div class="docs-content-grid">
          <article class="docs-body prose-content">
            <slot />
          </article>

          <TableOfContents headings={headings} />

          <div class="docs-footer">
            <slot name="footer" />
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --docs-sidebar-w: 260px;
    --docs-body-w: 640px;
    --docs-toc-w: 200px;
    --docs-gap: 48px;
    --docs-toc-top: 32px;
  }

  .docs-layout {
    display: grid;
    grid-template-columns: var(--docs-sidebar-w) 1fr;
    min-height: 100vh;
  }

  .docs-sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }

  .docs-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    min-height: 100vh;
  }

  .docs-titlebar,
  .docs-preview,
  .docs-content-grid {
    width: calc(var(--docs-body-w) + var(--docs-gap) + var(--docs-toc-w));
  }

  .docs-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-shrink: 0;
  }

  .titlebar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .docs-content-grid {
    display: grid;
    grid-template-columns: var(--docs-body-w) var(--docs-toc-w);
    grid-template-rows: auto 1fr auto;
    column-gap: var(--docs-gap);
    align-items: start;
  }

  .docs-body {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
    width: 100%;
  }

  .docs-footer {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  .docs-toc {
    grid-column: 2;
    grid-row: 2;
  }

  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }
    .docs-sidebar {
      display: none;
    }
    .docs-main {
      align-items: stretch;
    }
    .docs-titlebar,
    .docs-preview,
    .docs-content-grid {
      width: 100%;
    }
    .docs-content-grid {
      grid-template-columns: 1fr;
    }
    .docs-footer {
      grid-column: 1;
    }
  }
</style>
