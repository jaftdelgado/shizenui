---
import "../styles/global.css";
import TableOfContents from "@components/astro/TableOfContents.astro";
import DocsHeader from "@components/astro/DocsHeader.astro";
import DocsSidebar from "@components/astro/DocsSidebar.astro";
import RepoLink from "@components/astro/RepoLink.astro";
import ThemeToggle from "@components/astro/ThemeToggle.astro";
import { SidebarInset, SidebarProvider, SidebarTrigger } from "@components/astro/sidebar";
import { resolveDocLinks } from "@utils/docs-links";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  preview?: string;
}

const rawProps = Astro.props;
const frontmatter = (rawProps as any).frontmatter ?? rawProps;

const title = frontmatter.title;
const description = frontmatter.description;
const headings: MarkdownHeading[] = rawProps.headings ?? [];

const sourceFile: string | undefined = frontmatter.sourceFile;
const styleFile: string | undefined = frontmatter.styleFile;

const { sourceUrl, stylesUrl } = resolveDocLinks(title, sourceFile, styleFile);

// Attached by the docs-preview plugin (plugins/docs-preview.mjs) from the page's `preview` frontmatter.
const PreviewComponent: any = frontmatter.previewComponent;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Shizen UI Docs</title>
    <slot name="head" />
  </head>
  <body>
    <SidebarProvider class="docs-layout">
      <slot name="sidebar">
        <DocsSidebar />
      </slot>

      <SidebarInset>
        <div class="docs-main">
          <div class="docs-topbar">
            <SidebarTrigger />
            <div class="docs-topbar-actions">
              <ThemeToggle />
              <RepoLink />
            </div>
          </div>

          <DocsHeader
            title={title}
            description={description}
            sourceUrl={sourceUrl}
            stylesUrl={stylesUrl}
          />

          {
            PreviewComponent && (
              <div class="docs-preview">
                <PreviewComponent />
              </div>
            )
          }

          <div class="docs-content-grid">
            <article class="docs-body prose-content">
              <slot />
            </article>

            <TableOfContents headings={headings} />

            <div class="docs-footer">
              <slot name="footer" />
            </div>
          </div>
        </div>
      </SidebarInset>
    </SidebarProvider>

    <script>
      // Off-screen blocks may skip rendering only once each has been rendered
      // and its real height remembered (see "Off-screen rendering skip" in
      // docs-layout.css). After load plus two frames, every block has been.
      const ready = () =>
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.documentElement.setAttribute("data-cv-ready", ""))
        );
      if (document.readyState === "complete") ready();
      else addEventListener("load", ready, { once: true });
    </script>
  </body>
</html>
