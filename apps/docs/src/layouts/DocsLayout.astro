---
import "../styles/global.css";
import TableOfContents from "@components/astro/TableOfContents.astro";
import SourceLinks from "@components/svelte/SourceLinks.svelte";
import DocsHeaderActions from "@components/svelte/DocsHeaderActions.svelte";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  preview?: string;
}

const rawProps = Astro.props;
const frontmatter = (rawProps as any).frontmatter ?? rawProps;

const title = frontmatter.title;
const description = frontmatter.description;
const preview = frontmatter.preview;
const headings: MarkdownHeading[] = rawProps.headings ?? [];

const sourceFile: string | undefined = frontmatter.sourceFile;
const styleFile: string | undefined = frontmatter.styleFile;

const toKebab = (str: string) => str.toLowerCase().replace(/\s+/g, "-");
const toPascal = (str: string) =>
  str.replace(/(?:^|\s)(\w)/g, (_: string, c: string) => c.toUpperCase()).replace(/\s+/g, "");

const slug = toKebab(title);
const pascal = toPascal(title);

const GITHUB_BASE = "https://github.com/jaftdelgado/shizenui/blob/develop";

const resolvedSourceFile = sourceFile ?? `${slug}/${pascal}.svelte`;
const resolvedStyleFile = styleFile ?? `${slug}.css`;

const sourceUrl = `${GITHUB_BASE}/packages/svelte/src/components/${resolvedSourceFile}`;
const stylesUrl = `${GITHUB_BASE}/packages/styles/src/components/${resolvedStyleFile}`;

const previewModules = import.meta.glob("../examples/svelte/**/*.astro", {
  eager: true
}) as Record<string, { default?: unknown }>;

const matchedPreviewPath = preview
  ? (() => {
      const previewPath = `../examples/svelte/${preview}.astro`;
      return previewModules[previewPath]
        ? previewPath
        : Object.keys(previewModules).find((path) => path.endsWith(`/${preview}.astro`));
    })()
  : undefined;

const PreviewComponent: any = matchedPreviewPath
  ? previewModules[matchedPreviewPath]?.default
  : undefined;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Docs</title>
    <slot name="head" />
  </head>
  <body>
    <div class="docs-layout">
      <aside class="docs-sidebar">
        <slot name="sidebar" />
      </aside>

      <div class="docs-main">
        <div class="docs-header">
          <div class="docs-titlebar">
            <h1>{title}</h1>
            <div class="titlebar-actions">
              <DocsHeaderActions title={title} description={description} client:load />
            </div>
          </div>

          {description && <p class="docs-description">{description}</p>}

          <div class="docs-source-links">
            <SourceLinks sourceUrl={sourceUrl} stylesUrl={stylesUrl} client:load />
          </div>
        </div>

        {
          PreviewComponent && (
            <div class="docs-preview">
              <PreviewComponent />
            </div>
          )
        }

        <div class="docs-content-grid">
          <article class="docs-body prose-content">
            <slot />
          </article>

          <TableOfContents headings={headings} />

          <div class="docs-footer">
            <slot name="footer" />
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
