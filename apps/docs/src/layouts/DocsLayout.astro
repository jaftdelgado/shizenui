---
import "../styles/global.css";
import TableOfContents from "@components/astro/TableOfContents.astro";
import DocsHeader from "@components/astro/DocsHeader.astro";
import { resolveDocLinks } from "@utils/docs-links";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  preview?: string;
}

const rawProps = Astro.props;
const frontmatter = (rawProps as any).frontmatter ?? rawProps;

const title = frontmatter.title;
const description = frontmatter.description;
const preview = frontmatter.preview;
const headings: MarkdownHeading[] = rawProps.headings ?? [];

const sourceFile: string | undefined = frontmatter.sourceFile;
const styleFile: string | undefined = frontmatter.styleFile;

const { sourceUrl, stylesUrl } = resolveDocLinks(title, sourceFile, styleFile);

const previewModules = import.meta.glob("../examples/svelte/**/*.astro", {
  eager: true
}) as Record<string, { default?: unknown }>;

const matchedPreviewPath = preview
  ? (() => {
      const previewPath = `../examples/svelte/${preview}.astro`;
      return previewModules[previewPath]
        ? previewPath
        : Object.keys(previewModules).find((path) => path.endsWith(`/${preview}.astro`));
    })()
  : undefined;

const PreviewComponent: any = matchedPreviewPath
  ? previewModules[matchedPreviewPath]?.default
  : undefined;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Shizen UI Docs</title>
    <slot name="head" />
  </head>
  <body>
    <div class="docs-layout">
      <aside class="docs-sidebar">
        <slot name="sidebar" />
      </aside>

      <div class="docs-main">
        <DocsHeader
          title={title}
          description={description}
          sourceUrl={sourceUrl}
          stylesUrl={stylesUrl}
        />

        {
          PreviewComponent && (
            <div class="docs-preview">
              <PreviewComponent />
            </div>
          )
        }

        <div class="docs-content-grid">
          <article class="docs-body prose-content">
            <slot />
          </article>

          <TableOfContents headings={headings} />

          <div class="docs-footer">
            <slot name="footer" />
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
