---
import "../styles/global.css";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Docs</title>
    <slot name="head" />
  </head>
  <body>
    <!-- ── Root: sidebar | main ── -->
    <div class="docs-layout">
      <!-- SIDEBAR -->
      <aside class="docs-sidebar">
        <slot name="sidebar" />
      </aside>

      <!-- MAIN -->
      <div class="docs-main">
        <!-- Title bar -->
        <div class="docs-titlebar">
          <div>
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </div>
          <div class="titlebar-actions">
            <slot name="actions" />
          </div>
        </div>

        <!-- body | toc -->
        <div class="docs-content-grid">
          <article class="docs-body prose-content">
            <slot />
          </article>

          {
            tocHeadings.length > 0 && (
              <aside class="docs-toc">
                <div class="toc-inner">
                  <slot name="toc-header">
                    <p>On this page</p>
                  </slot>
                  <nav>
                    <ul>
                      {tocHeadings.map((heading) => (
                        <li class={`toc-h${heading.depth}`}>
                          <a href={`#${heading.slug}`} class="toc-link" data-heading={heading.slug}>
                            {heading.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </nav>
                </div>
              </aside>
            )
          }
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  /* ── Layout shell: sidebar | main ── */
  .docs-layout {
    display: grid;
    grid-template-columns: var(--docs-sidebar-w, 260px) 1fr;
    min-height: 100vh;
  }

  /* ── Sidebar: sticky, full height ── */
  .docs-sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }

  /* ── Main: column flex ── */
  .docs-main {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* ── Titlebar: full width of main ── */
  .docs-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-shrink: 0;
  }

  .titlebar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* ── Content grid: body | toc ── */
  .docs-content-grid {
    display: grid;
    grid-template-columns: 1fr var(--docs-toc-w, 220px);
    flex: 1;
    align-items: start;
  }

  /* ── Body ── */
  .docs-body {
    min-width: 0;
  }

  :global(.full-bleed) {
    width: calc(100% + var(--docs-body-pr, 32px));
    margin-right: calc(-1 * var(--docs-body-pr, 32px));
  }

  /* ── TOC: sticky al scrollear ── */
  .docs-toc {
    position: relative;
  }

  .toc-inner {
    position: sticky;
    top: var(--docs-toc-top, 32px);
  }

  .toc-h3 {
    padding-left: 12px;
  }

  .toc-link.active {
    font-weight: 500;
  }

  /* ── Mobile: ocultar sidebar y TOC ── */
  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }
    .docs-sidebar {
      display: none;
    }
    .docs-content-grid {
      grid-template-columns: 1fr;
    }
    .docs-toc {
      display: none;
    }
    :global(.full-bleed) {
      width: 100%;
      margin-right: 0;
    }
  }
</style>

<script>
  // Marca el toc-link activo según el heading visible
  const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>(".docs-body h2, .docs-body h3")
  );

  if (links.length && headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            links.forEach((l) => l.classList.remove("active"));
            document
              .querySelector<HTMLAnchorElement>(`.toc-link[href="#${id}"]`)
              ?.classList.add("active");
          }
        }
      },
      { rootMargin: "-20% 0px -70% 0px" }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>
