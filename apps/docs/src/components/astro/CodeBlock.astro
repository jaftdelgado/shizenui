---
import { codeToHtml } from "shiki";
import CopyButton from "@components/svelte/CopyButton.svelte";
import CodeBlockToggle from "@components/svelte/CodeBlockToggle.svelte";

interface Props {
  code: string;
  lang?: string;
  theme?: string;
  showLineNumbers?: boolean;
  isContained?: boolean;
  collapsible?: boolean;
}

const {
  code = "",
  lang = "svelte",
  theme = "github-light",
  showLineNumbers = true,
  isContained = false,
  collapsible = true
} = Astro.props;

const cleanedCode = code.trim();

const highlightedCode = await codeToHtml(cleanedCode, {
  lang,
  theme,
  structure: "classic"
});

const instanceId = crypto.randomUUID();
---

<div
  class:list={[
    "bg-component code-block-root relative",
    {
      "shadow-border my-8 rounded-2xl": !isContained,
      "rounded-none border-none shadow-none": isContained
    }
  ]}
  data-code-block={instanceId}
  data-lang={lang}
  data-collapsed={collapsible ? "true" : undefined}
>
  <div
    class:list={["shiki-container overflow-x-auto pt-2", { "line-numbers": showLineNumbers }]}
    data-code-content={instanceId}
  >
    <Fragment set:html={highlightedCode} />
  </div>

  <div class="absolute top-2 right-2">
    <CopyButton text={cleanedCode} client:load />
  </div>

  {
    collapsible && (
      <div class="code-block-footer">
        <CodeBlockToggle instanceId={instanceId} collapsed={true} client:load />
      </div>
    )
  }
</div>
