---
import { codeToHtml } from "shiki";

interface Props {
  code?: string;
  lang?: string;
  theme?: string;
}

const { code: codeProp = "", lang = "ts", theme = "github-light" } = Astro.props;

const rawSlot = Astro.slots.has("default") ? await Astro.slots.render("default") : null;

const code = rawSlot ? rawSlot.replace(/<[^>]*>/g, "").trim() : codeProp;

const highlightedCode = await codeToHtml(code, {
  lang,
  theme,
  structure: "classic"
});
---

<div class="bg-component code-import-root shadow-border my-4 rounded-2xl" data-lang={lang}>
  <div class="shiki-container code-import-content overflow-x-auto font-mono">
    <Fragment set:html={highlightedCode} />
  </div>
</div>
