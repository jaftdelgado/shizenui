---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 && (
    <aside class="docs-toc">
      <div class="toc-inner">
        <slot name="toc-header">
          <p class="toc-label">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              color="currentColor"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 5L16 5" />
              <path d="M4 12L20 12" />
              <path d="M4 19L12 19" />
            </svg>
            On this page
          </p>
        </slot>
        <nav>
          <ul>
            {tocHeadings.map((heading) => (
              <li class={`toc-h${heading.depth}`}>
                <a href={`#${heading.slug}`} class="toc-link" data-heading={heading.slug}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  )
}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>(".docs-body h2, .docs-body h3")
  );

  if (links.length && headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            links.forEach((l) => l.classList.remove("active"));
            document
              .querySelector<HTMLAnchorElement>(`.toc-link[href="#${id}"]`)
              ?.classList.add("active");
          }
        }
      },
      { rootMargin: "-20% 0px -70% 0px" }
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
