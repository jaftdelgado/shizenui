---
import Icon from "@components/svelte/Icon.svelte";
import {
  CheckmarkSquare02Icon,
  MousePointerOffIcon,
  ViewIcon,
  Alert02Icon,
  FocusIcon,
  CursorMagicSelection04Icon,
  CursorRectangleSelection02Icon,
  RemoveSquareIcon,
  Loading03Icon,
  Asterisk02Icon,
  CircleIcon
} from "@hugeicons/core-free-icons";

interface StateProp {
  name: string;
  description?: string;
}

interface Props {
  props: StateProp[];
}

const { props } = Astro.props;

const stateIconMap: Record<string, typeof CircleIcon> = {
  checked: CheckmarkSquare02Icon,
  disabled: MousePointerOffIcon,
  readonly: ViewIcon,
  invalid: Alert02Icon,
  focus: FocusIcon,
  pressed: CursorMagicSelection04Icon,
  hover: CursorRectangleSelection02Icon,
  selected: CheckmarkSquare02Icon,
  indeterminate: RemoveSquareIcon,
  loading: Loading03Icon,
  required: Asterisk02Icon
};

function resolveIcon(name: string) {
  return stateIconMap[name] ?? CircleIcon;
}

function formatName(name: string) {
  return name
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}
---

<div class="my-8 w-full overflow-x-auto">
  <table class="w-full">
    <tbody>
      {
        props.map((prop) => (
          <tr class="border-tertiary-text/30 h-14 border-t tracking-tight last:border-b">
            <td class="w-10 pr-2 text-sm">
              <Icon icon={resolveIcon(prop.name)} size={20} client:visible />
            </td>
            <td class="w-1/5 pr-8 text-sm font-medium">{formatName(prop.name)}</td>
            <td class="text-primary-text text-sm">
              {prop.description ?? <span class="text-foreground/30">—</span>}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
