---
/** Ghost icon-only Button that toggles the sidebar (the drawer below 80rem). */
import type { HTMLAttributes } from "astro/types";
import { buttonStyles } from "@shizen-ui/styles";

interface Props extends HTMLAttributes<"button"> {
  /** id of the <Sidebar /> it controls. @default "app-sidebar" */
  controls?: string;
}

const { controls = "app-sidebar", class: className, ...rest } = Astro.props;
const hasIcon = Astro.slots.has("default");

const styles = buttonStyles({ variant: "ghost", iconOnly: true });
---

<button
  type="button"
  data-sidebar="trigger"
  aria-label="Toggle sidebar"
  aria-controls={controls}
  aria-expanded="true"
  class:list={[styles.base(), className]}
  {...rest}
>
  <span class={styles.content()}>
    <span class={styles.icon()}>
      {
        hasIcon ? (
          <slot />
        ) : (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 12C2 8.31087 2 6.4663 2.81382 5.15877C3.1149 4.67502 3.48891 4.25427 3.91891 3.91554C5.08116 3 6.72077 3 10 3H14C17.2792 3 18.9188 3 20.0811 3.91554C20.5111 4.25427 20.8851 4.67502 21.1862 5.15877C22 6.4663 22 8.31087 22 12C22 15.6891 22 17.5337 21.1862 18.8412C20.8851 19.325 20.5111 19.7457 20.0811 20.0845C18.9188 21 17.2792 21 14 21H10C6.72077 21 5.08116 21 3.91891 20.0845C3.48891 19.7457 3.1149 19.325 2.81382 18.8412C2 17.5337 2 15.6891 2 12Z" />
            <path d="M9.5 3L9.5 21" />
            <path d="M5 7H6M5 10H6" />
          </svg>
        )
      }
    </span>
  </span>
</button>
