---
import { readFile } from "node:fs/promises";
import CodeBlock from "./CodeBlock.astro";

interface Props {
  src?: string;
  lang?: string;
  theme?: string;
  showLineNumbers?: boolean;
}

const { src, lang = "svelte", theme, showLineNumbers = true } = Astro.props;

// Read from disk instead of an `import.meta.glob(..., { query: "?raw" })`: in dev, Astro follows
// every import of a page to collect its CSS, and a glob would compile all examples on every page.
// Paths are relative to the docs app root, where `astro dev` and `astro build` run.
const code = src ? (await readFile(`./src/examples/${src}`, "utf8")).trim() : "";
---

<section class="example-container my-8" aria-label="Component Example" data-example-container>
  <div class="example-container-inner">
    <div class="flex min-h-96 items-center justify-center p-12">
      <slot />
    </div>

    {
      code && (
        <div class="border-separator border-t" aria-label="Component Example Code">
          <CodeBlock
            code={code}
            lang={lang}
            theme={theme}
            showLineNumbers={showLineNumbers}
            isContained
          />
        </div>
      )
    }
  </div>
</section>
