{
  "name": "@shizen-ui/svelte",
  "version": "0.0.1",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components/*": {
      "svelte": "./src/components/*.svelte",
      "types": "./src/components/*.svelte"
    },
    "./contexts/*": {
      "types": "./src/contexts/*.ts",
      "import": "./src/contexts/*.ts"
    }
  },
  "scripts": {
    "add-component": "bun scripts/add-component.ts"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@shizen-ui/styles": "workspace:*",
    "@floating-ui/dom": "^1.7.4",
    "clsx": "^2.1.1",
    "focus-trap": "^8.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.1"
  }
}
